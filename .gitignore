# Dependencies (workspace root + packages)
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
!.env*.example

# Build / generated output (any package)
**/build/
**/dist/
out/
.next/
.turbo/

# Test / coverage
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE (uncomment if you do not commit editor settings)
# .vscode/
.idea/

# Certificates / keys (keep infra-specific ignores in infra/.gitignore too)
*.pem

# Caches
.cache/
.parcel-cache/
.eslintcache

# Debug
*.pid
*.seed
*.pid.lock
