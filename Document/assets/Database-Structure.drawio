          <mxGeometry height="120" width="200" y="30" as="geometry" />
        </mxCell>
        <mxCell id="notes" parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" value="NOTES" vertex="1">
